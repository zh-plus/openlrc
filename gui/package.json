{
  "name": "openlrc-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "OpenLRC Desktop GUI v1",
  "main": ".webpack/main",
  "type": "commonjs",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "clsx": "2.1.1",
    "electron-log": "5.4.4",
    "i18next": "26.3.6",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jasmine": "6.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wdio/cli": "9.30.0",
    "@wdio/electron-service": "10.0.0",
    "@wdio/globals": "9.29.1",
    "@wdio/jasmine-framework": "9.30.0",
    "@wdio/local-runner": "9.30.0",
    "@wdio/native-types": "2.4.0",
    "@wdio/spec-reporter": "9.29.1",
    "css-loader": "7.1.4",
    "electron": "43.2.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.6",
    "puppeteer-core": "25.4.0",
    "style-loader": "4.0.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "webdriverio": "9.30.0",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
